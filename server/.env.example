# Required: >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Required unless OPEN_SIGNUP=true: protects workspace creation.
ADMIN_API_KEY=
OPEN_SIGNUP=false
PORT=8787
DATABASE_PATH=./data/formify.db
# Comma-separated browser origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=http://localhost:3000
# Set true ONLY behind a reverse proxy you control (trusts X-Forwarded-For for rate limiting).
TRUST_PROXY=false
# Webhook safety. Leave false in production.
ALLOW_PRIVATE_WEBHOOKS=false
ALLOW_HTTP_WEBHOOKS=false
